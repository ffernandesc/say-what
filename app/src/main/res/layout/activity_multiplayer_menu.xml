<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    tools:context=".ui.multiplayer.MultiplayerMenuActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_multiplayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:layout_marginLeft="5dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/button_multiplayer"
            android:textAlignment="center"
            android:textSize="35sp"
            android:textColor="@color/yellow"
            android:fontFamily="@font/carter_one"
            android:shadowColor="@color/blue_pressed"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="5" />

        <TextView
            android:id="@+id/tv_welcome_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="40dp"
            android:fontFamily="@font/carter_one"
            android:text="@string/welcome"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="50dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_create_match"
                android:layout_width="275dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="5dp"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/red"
                android:fontFamily="@font/carter_one"
                android:textAlignment="center"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="15sp"
                app:autoSizeMaxTextSize="35sp"
                android:lines="2"
                android:shadowColor="@color/blue_pressed"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="5"
                android:text="@string/create_match" />

            <Button
                android:id="@+id/btn_join_match"
                android:layout_width="275dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/purple"
                android:fontFamily="@font/carter_one"
                android:textAlignment="center"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="15sp"
                app:autoSizeMaxTextSize="35sp"
                android:lines="2"
                android:shadowColor="@color/blue_pressed"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="5"
                android:text="@string/join_match" />

        </LinearLayout>


    </LinearLayout>

    <include
        android:id="@+id/notification_overlay"
        layout="@layout/layout_notification_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="60dp"
        android:visibility="gone" />

</FrameLayout>