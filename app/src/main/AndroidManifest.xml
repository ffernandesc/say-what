<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SayWhat">
        <activity
            android:name=".ui.multiplayer.GameOverActivity"
            android:exported="false" />
        <activity
            android:name=".ui.singleplayer.LeaderboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.multiplayer.GameActivity"
            android:exported="false" />
        <activity
            android:name=".ui.multiplayer.JoinGameActivity"
            android:exported="false" />
        <activity
            android:name=".ui.multiplayer.LobbyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.multiplayer.MultiplayerMenuActivity"
            android:exported="false" />
        <activity
            android:name=".ui.singleplayer.SingleplayerGameActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>