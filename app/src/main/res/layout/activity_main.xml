<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_weight="0.1">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            app:srcCompat="@mipmap/ic_launcher_foreground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/star1"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:srcCompat="@drawable/blue_star"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp" />

        <ImageView
            android:id="@+id/star2"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:srcCompat="@drawable/blue_pressed_star"
            app:layout_constraintTop_toBottomOf="@+id/star5"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="25dp" />

        <ImageView
            android:id="@+id/star3"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:srcCompat="@drawable/red_star"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="20dp" />

        <ImageView
            android:id="@+id/star4"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:srcCompat="@drawable/red_pressed_star"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="145dp"
            android:layout_marginStart="20dp" />

        <ImageView
            android:id="@+id/star5"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:srcCompat="@drawable/yellow_star"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="150dp"
            android:layout_marginEnd="20dp" />

        <ImageView
            android:id="@+id/star6"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:srcCompat="@drawable/yellow_pressed_star"
            app:layout_constraintTop_toBottomOf="@+id/star4"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="50dp"
            android:layout_marginStart="20dp" />

        <ImageView
            android:id="@+id/star7"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:srcCompat="@drawable/purple_star"
            app:layout_constraintTop_toBottomOf="@+id/star8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="150dp"
            android:layout_marginStart="60dp" />

        <ImageView
            android:id="@+id/star8"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:srcCompat="@drawable/purple_pressed_star"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="35dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/button_singleplayer"
        android:layout_width="275dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_weight="0.3"
        android:backgroundTint="@color/red"
        android:fontFamily="@font/carter_one"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="15sp"
        app:autoSizeMaxTextSize="35sp"
        android:lines="1"
        android:shadowColor="@color/blue_pressed"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="5"
        android:text="@string/button_singleplayer" />

    <Button
        android:id="@+id/button_multiplayer"
        android:layout_width="275dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_weight="0.3"
        android:backgroundTint="@color/yellow"
        android:fontFamily="@font/carter_one"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="15sp"
        app:autoSizeMaxTextSize="35sp"
        android:lines="1"
        android:shadowColor="@color/blue_pressed"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="5"
        android:text="@string/button_multiplayer" />

    <Button
        android:id="@+id/button_options"
        android:layout_width="275dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center_horizontal"
        android:layout_weight="0.3"
        android:backgroundTint="@color/purple"
        android:fontFamily="@font/carter_one"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="15sp"
        app:autoSizeMaxTextSize="35sp"
        android:lines="1"
        android:shadowColor="@color/blue_pressed"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="5"
        android:text="@string/button_options" />
    </LinearLayout>
    
    <FrameLayout
        android:id="@+id/overlay_difficulty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">
        
        <androidx.cardview.widget.CardView
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="#CC222222"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_diff_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_difficulty_title"
                    android:fontFamily="@font/carter_one"
                    android:textColor="@color/yellow"
                    android:textSize="26sp"
                    android:textAlignment="center"
                    android:shadowColor="@color/blue_pressed"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="5"
                    android:layout_marginBottom="15dp" />

                <Button
                    android:id="@+id/btn_diff_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/blue"
                    android:textColor="@color/white"
                    android:fontFamily="@font/carter_one"
                    android:text="@string/_4_buttons_classic"
                    android:layout_marginBottom="5dp" />

                <Button
                    android:id="@+id/btn_diff_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/green"
                    android:textColor="@color/white"
                    android:fontFamily="@font/carter_one"
                    android:text="@string/_5_buttons"
                    android:layout_marginBottom="5dp" />

                <Button
                    android:id="@+id/btn_diff_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/pink"
                    android:textColor="@color/white"
                    android:fontFamily="@font/carter_one"
                    android:text="@string/_6_buttons"
                    android:layout_marginBottom="5dp" />

                <Button
                    android:id="@+id/btn_diff_7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/orange"
                    android:textColor="@color/white"
                    android:fontFamily="@font/carter_one"
                    android:text="@string/_7_buttons"
                    android:layout_marginBottom="5dp" />

                <Button
                    android:id="@+id/btn_diff_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/red"
                    android:textColor="@color/white"
                    android:fontFamily="@font/carter_one"
                    android:text="@string/_8_buttons_extreme"
                    android:layout_marginBottom="15dp" />

                <ImageButton
                    android:id="@+id/btn_close_diff"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/button_darkblue_selector"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/white"
                    android:contentDescription="@string/cancel" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>
        

</FrameLayout>