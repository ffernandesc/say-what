<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:padding="24dp"
    android:gravity="center_horizontal"
    tools:context=".ui.multiplayer.LobbyActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/game_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="5dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/game_code"
            android:textAlignment="center"
            android:textSize="35sp"
            android:textColor="@color/yellow"
            android:fontFamily="@font/carter_one"
            android:shadowColor="@color/blue_pressed"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="5" />

        <TextView
            android:id="@+id/tv_game_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="5dp"
            android:layout_gravity="center_horizontal"
            android:text="1234"
            android:textAlignment="center"
            android:textSize="60sp"
            android:letterSpacing="0.2"
            android:textColor="@color/purple"
            android:fontFamily="@font/carter_one"
            android:shadowColor="@color/blue_pressed"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="5" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_players_joined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="40dp"
            android:fontFamily="@font/carter_one"
            android:text="@string/players_joined"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_player_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:text="Waiting..."
            android:textColor="@color/white"
            android:textAlignment="center"
            android:textSize="24sp"
            android:lineSpacingExtra="8dp"/>

    </LinearLayout>

    <Button
        android:id="@+id/btn_start"
        android:layout_width="275dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="5dp"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@drawable/button_red_selector"
        android:fontFamily="@font/carter_one"
        android:textAlignment="center"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="15sp"
        app:autoSizeMaxTextSize="35sp"
        android:lines="1"
        android:shadowColor="@color/blue_pressed"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="5"
        android:text="@string/start" />

</LinearLayout>