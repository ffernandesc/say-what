<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:padding="30dp"
    android:gravity="center"
    tools:context=".ui.multiplayer.JoinGameActivity">

    <TextView
        android:id="@+id/tv_enter_game_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/carter_one"
        android:text="@string/enter_game_code"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="22sp" />

    <EditText
        android:id="@+id/et_game_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:textColor="@color/white"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="4"
        android:hint="XXXX"
        android:textColorHint="#80FFFFFF"
        android:textSize="60sp"/>

    <Button
        android:id="@+id/btn_join"
        android:layout_width="275dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="5dp"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@drawable/button_yellow_selector"
        android:fontFamily="@font/carter_one"
        android:textAlignment="center"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="15sp"
        app:autoSizeMaxTextSize="35sp"
        android:lines="1"
        android:shadowColor="@color/blue_pressed"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="5"
        android:text="@string/join" />

</LinearLayout>